include "csp-gen/sim/defs/core_timed_defs.csp"
include "csp-gen/sim/defs/file_testingLoopComplexNotGuard_defs.csp"
include "csp-gen/sim/defs/core_defs.csp"
include "csp-gen/sim/defs/M_C_wfSTM.csp"
include "csp-gen/sim/defs/state_timed_defs.csp"
include "csp-gen/sim/defs/robochart_defs.csp"
include "csp-gen/sim/instantiations.csp"

transparent wbisim
transparent chase
channel r__

SYSTEM = 
    let
        cycle_M_C_wfSTM_wfSTM = 1
        id__ = 0
    within
        M_C_wfSTM::D__(id__, cycle_M_C_wfSTM_wfSTM)
        
SYSTEM_H = SYSTEM \ {M_C_wfSTM::endexec, tock}



-- Checks that the body runs when all guards come out true
assert SYSTEM_H :[has trace]: <
    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,

    M_C_wfSTM::registerWrite.M_C_wfSTM::o_VacuumStart,

    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,

    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,

    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,

    M_C_wfSTM::registerWrite.M_C_wfSTM::o_ReturnToDockStart,
    
    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,
    
    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,
    
    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.true>
    


-- Checks that the Task cannot run when one guard is false
assert not SYSTEM_H :[has trace]: <
    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,

    M_C_wfSTM::registerWrite.M_C_wfSTM::o_VacuumStart,

    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,

    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,

    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,

    M_C_wfSTM::registerWrite.M_C_wfSTM::o_ReturnToDockStart,
    
    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,
    
    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,
    
    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.true>
    
    

-- Checks that the Task cannot run when one guard is false
assert not SYSTEM_H :[has trace]: <
    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,

    M_C_wfSTM::registerWrite.M_C_wfSTM::o_VacuumStart,

    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,

    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,

    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,

    M_C_wfSTM::registerWrite.M_C_wfSTM::o_ReturnToDockStart,
    
    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,
    
    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,
    
    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.true>
    
    

-- Checks that the Task cannot run when both guards are false
assert not SYSTEM_H :[has trace]: <
    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,

    M_C_wfSTM::registerWrite.M_C_wfSTM::o_VacuumStart,

    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,

    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,

    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,

    M_C_wfSTM::registerWrite.M_C_wfSTM::o_ReturnToDockStart,
    
    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,
    
    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.true,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_needsVacuuming.true.true,
    
    M_C_wfSTM::registerRead.M_C_wfSTM::i_VacuumEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_ReturnToDockEnd.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_daytime.true.false,
    M_C_wfSTM::registerRead.M_C_wfSTM::i_wayBlocked.true.true>