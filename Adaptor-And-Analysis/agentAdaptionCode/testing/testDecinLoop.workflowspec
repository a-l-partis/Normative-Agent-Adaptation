WorkflowStructure {
	workflowspec Loop {
		loop GuardedWorkflow {
			body Decision {
				options {
					GuardedWorkflow {
						body Task {
							ID "Vacuum"
						}
						guard Atom {
							measureID "needsVacuuming"}
						},
						GuardedWorkflow {
						body Task {
							ID "Skip"
						}
						
						guard Not {
							op "not"
							expr Atom {
								measureID "needsVacuuming"}
							}
					}
				}
				
			}

			guard Not {
				op "not"
				expr Atom {
				measureID "userPraying"
				}
			}
			
		}	
	}
}