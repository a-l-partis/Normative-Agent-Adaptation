WorkflowStructure {
	workflowspec Decision {
		options {
			GuardedWorkflow {
				body Decision {
					options {
						GuardedWorkflow {
							body Task {
								ID "Vacuum"
							}
							guard Not {
								op "not"
								expr Atom {
								measureID "personPresent"
								}
							}
						}
					}
				}
				guard Atom {
					measureID "needsVacuuming"
				}
			}
		}
	}
}
