WorkflowStructure {
	workflowspec Loop {
		loop GuardedWorkflow {
			body Loop {
				loop GuardedWorkflow {
					body Task {
					ID "Vacuum"
					}
					guard Atom {
						measureID "needsVacuuming"
					}
				}
			}
			guard Not {
				op "not"
				expr Atom {
					measureID "personPresent"
				}
			}

		}
	}
	
}