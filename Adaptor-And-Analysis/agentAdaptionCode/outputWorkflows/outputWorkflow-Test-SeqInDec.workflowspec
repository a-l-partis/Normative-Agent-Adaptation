WorkflowStructure {
	 workflowspec Decision {
		options {
			GuardedWorkflow {
				body Sequence {
					subworkflows {
						Task {
							ID "Undock"},
						Task {
							ID "AlertUser"},
						Task {
							ID "Vacuum"},
						Task {
							ID "LeaveRoom"}
					}
				}
				guard Atom {
					measureID "needsVacuuming"
				}
			},
			GuardedWorkflow {
				body Task {
					ID "Skip"}
				guard Not {
					op not
					expr Atom {
					measureID "needsVacuuming"
				}
				}
			}
		}
	}
}