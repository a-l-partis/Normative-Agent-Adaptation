def_start
	event ReadCustomerGreetingEnd
	event WarnUser
	event PassOntoHumanOperatorStart
	event SetSympatheticTone
	measure userFrustrated : boolean
def_end
rule_start
	Rule0 when PassOntoHumanOperatorStart then WarnUser
	Rule1 when ReadCustomerGreetingEnd and userFrustrated then SetSympatheticTone
rule_end
